# standard env var to check for env vars loading
LANG_TUTOR_SAMPLE_ENV_VAR=sample

## CONTENT SOURCE ##

# Where word content comes from: "http" (default, the lang-tools service) or
# "in_process" (read the lang-tools store directly, for local dev).
LANG_TOOLS_CONTENT_SOURCE=http

# Base URL of the lang-tools read service when source=http. Uses 8010 to avoid
# colliding with the lang-tutor webapp on 8000.
LANG_TOOLS_BASE_URL=http://127.0.0.1:8010

## LEARNER ##

# The language being learned and the languages the learner knows (look-alikes
# toward these are flagged as false friends or cognates).
LANG_TUTOR_TARGET_LANGUAGE=pt
LANG_TUTOR_KNOWN_LANGUAGES=en,it

## WEBAPP ##

# Google OAuth (required)
GOOGLE_CLIENT_ID=aaa.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=some-secret-value  # pragma: allowlist secret

# Session security (required in production, auto-generated in dev)
SESSION_SECRET_KEY=some-secret-value  # pragma: allowlist secret
